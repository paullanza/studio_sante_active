<%# Allocation rows: cards on a phone, columns under the head from 768 px.
    Locals: definitions, active_counts, query. %>
<div class="allocation-list">
  <div class="allocation-list__head" aria-hidden="true">
    <span>DefID</span><span>Nom</span><span>Séances</span><span>Absences</span><span>Services actifs</span><span></span>
  </div>
  <% definitions.each do |definition| %>
    <%= render "row", definition: definition, active_count: active_counts.fetch(definition.service_id, 0), query: query %>
  <% end %>
</div>
