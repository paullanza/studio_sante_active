<%# A consultation in Saisir's recent list (mine, latest first): the date, the
    prospect, the phone (« (514) 555-0142 ») or else the email, and presence.
    Local: consultation. %>
<li class="card latest-consultation<%= " latest-consultation--absence" if consultation.present == false %>">
  <span class="latest-consultation__main">
    <span class="latest-consultation__name"><%= consultation.full_name.presence || "—" %></span>
    <span class="latest-consultation__when numeric">
      <%= consultation.occurred_at ? seance_datetime(consultation.occurred_at) : "—" %>
    </span>
    <% if consultation.phone_number.present? %>
      <span class="text-muted text-small numeric"><%= format_phone(consultation.phone_number) %></span>
    <% elsif consultation.email.present? %>
      <span class="text-muted text-small"><%= consultation.email %></span>
    <% end %>
  </span>
  <% if consultation.present %>
    <span class="badge badge--chargee">Présent·e</span>
  <% elsif consultation.present == false %>
    <span class="badge badge--absence">Absent·e</span>
  <% end %>
</li>
