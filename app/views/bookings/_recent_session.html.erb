<%# A séance in Saisir's recent list (the trainer's latest): a compact row whose
    client and date link to its Service page, then « Modifier » and « Supprimer »
    when allowed. Locals: session, trainer_id (the list's trainer). %>
<div class="card latest-seance latest-seance--<%= session.outcome %>">
  <%= link_to fliip_service_path(session.fliip_service_id), data: { turbo_frame: "_top" }, class: "latest-seance__link" do %>
    <span class="latest-seance__main">
      <span class="latest-seance__client"><%= session.fliip_user&.full_name.presence || "—" %></span>
      <span class="latest-seance__when numeric"><%= seance_datetime(session.occurred_at) %> · <%= session.duration_short %></span>
      <span class="text-muted text-small"><%= session.fliip_service&.service_name.presence || "Service" %></span>
    </span>
    <span class="badge <%= outcome_badge_class(session) %>"><%= session.outcome_label %></span>
  <% end %>
  <%= render "sessions/card_actions", session: session, context: "saisir", trainer_id: trainer_id %>
</div>
