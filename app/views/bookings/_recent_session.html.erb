<%# A séance in Saisir's recent list: a compact row linking to its Service page.
    Locals: session, show_client (the client's name, when no client is chosen). %>
<li>
  <%= link_to fliip_service_path(session.fliip_service_id), class: "card recent-seance recent-seance--#{session.outcome}" do %>
    <span class="recent-seance__main">
      <% if show_client %>
        <span class="recent-seance__client"><%= session.fliip_user&.full_name.presence || "—" %></span>
      <% end %>
      <span class="recent-seance__when numeric"><%= seance_datetime(session.occurred_at) %> · <%= session.duration_short %></span>
      <span class="text-muted text-small"><%= session.user&.full_name.presence || "—" %> · <%= session.fliip_service&.service_name.presence || "Service" %></span>
    </span>
    <span class="badge <%= outcome_badge_class(session) %>"><%= session.outcome_label %></span>
  <% end %>
</li>
