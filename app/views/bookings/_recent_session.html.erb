<%# A séance in Saisir's recent list (the trainer's latest), in two columns: the
    client, the service, the date with the duration, and « Modifier » /
    « Supprimer » on the left; the outcome badge over the service's Temps and
    Séances bars and its counts on the right. The client's name links to the Service
    page and its link covers the card; the buttons sit above it. An Absence or
    a -24h séance gets the séance card's stripe and tint.
    Locals: session, trainer_id (the list's trainer). %>
<% service = session.fliip_service %>
<article class="card latest-seance seance-card--<%= session.outcome %>">
  <div class="latest-seance__main">
    <%= link_to session.fliip_user&.full_name.presence || "—", fliip_service_path(session.fliip_service_id),
          class: "latest-seance__link", data: { turbo_frame: "_top" } %>
    <span class="latest-seance__service text-muted text-small"><%= service&.service_name.presence || "Service" %></span>
    <span class="latest-seance__when text-small numeric"><strong><%= seance_datetime(session.occurred_at) %></strong> <span class="nowrap">· <%= session.duration_short %></span></span>
  </div>

  <div class="latest-seance__usage numeric">
    <span class="badge latest-seance__badge <%= outcome_badge_class(session) %>"><%= session.outcome_label %></span>
    <% if service && !service.removed_from_fliip? %>
      <%= render "fliip_services/bars", service: service %>
      <div class="latest-seance__counts text-muted">
        <% if service.allocation_to_define? %>
          Allocation à définir
        <% else %>
          <%= format_count(service.paid_used_total) %> / <%= format_count(service.paid_allowed_total) %> ·
          abs. <%= format_count(service.free_used_total) %> / <%= format_count(service.free_allowed_total) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= render "sessions/card_actions", session: session, context: "saisir", trainer_id: trainer_id %>
</article>
