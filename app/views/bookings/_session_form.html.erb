<%# Saisir's séance tab, main column: the client, then (once chosen) the séance
    form as grouped rows. Its button is in bookings/_session_ticket (form="seance_form"). %>
<section class="form-section" aria-labelledby="saisir-client">
  <header class="form-section__head"><h2 id="saisir-client">Client·e</h2></header>

  <% if @client %>
    <div class="card chosen-client">
      <%= client_avatar(@client) %>
      <div class="chosen-client__who">
        <%= link_to @client.full_name.presence || "—", fliip_user_path(@client), class: "client-name chosen-client__name" %>
        <span class="text-muted text-small numeric">ID <%= @client.id %> · FliipUserID <%= @client.remote_id %></span>
      </div>
      <% if @client.missing_from_fliip? %><span class="badge badge--retire">Retiré de Fliip</span><% end %>
      <%= link_to "Changer", new_seance_path, class: "btn btn--secondary btn--small chosen-client__change" %>
    </div>
  <% else %>
    <div class="client-picker" data-controller="client-search" data-action="focusout->client-search#leave keydown.esc->client-search#clear">
      <div class="field field--compact">
        <label class="field__box" for="client_search_input">
          <span class="field__icon"><%= icon_svg(LayoutHelper::NAV_ICONS["clients"], size: 20) %></span>
          <span class="field__label visually-hidden">Client·e</span>
          <input id="client_search_input" type="search" class="field__input" autocomplete="off"
                 placeholder="Nom, courriel ou téléphone"
                 aria-describedby="client_search_hint" aria-controls="client_suggestions"
                 data-client-search-target="input"
                 data-action="input->client-search#search keydown.enter->client-search#pickFirst">
        </label>
        <p class="field__hint" id="client_search_hint">Les suggestions apparaissent dès 2 caractères.</p>
      </div>
      <%= turbo_frame_tag "client_suggestions", target: "_top", class: "client-picker__suggestions" %>
    </div>
  <% end %>
</section>

<% if @client %>
  <% service_error = @session.errors[:fliip_service_id].first || @session.errors[:fliip_service].first %>
  <%= form_with model: @session, url: sessions_path, id: "seance_form", builder: StudioFormBuilder, class: "form",
        data: { confirm_dialog_target: "form", action: "submit->confirm-dialog#check" } do |f| %>
    <%= f.base_errors(also: %i[occurred_at fliip_user_id created_by]) %>
    <%= f.hidden_field :fliip_user_id %>

    <%# Absence changes the outcome, so presence comes first and big. %>
    <%= f.switch :present, [ [ safe_join([ icon_svg(LayoutHelper::CHECK_ICON, size: 22, stroke_width: 2.4), "Présent·e" ]), "1" ],
                             [ safe_join([ icon_svg(LayoutHelper::CROSS_ICON, size: 22, stroke_width: 2.4), "Absent·e" ]), "0" ] ],
          label: "Présence" %>

    <fieldset class="form-section service-choice" aria-describedby="<%= 'session_fliip_service_id_error' if service_error %>">
      <legend class="form-section__head service-choice__legend">Service</legend>
      <% if @services.any? %>
        <div class="service-options">
          <% @services.each do |service| %>
            <%= render "bookings/service_option", service: service, checked: service.id == @session.fliip_service_id %>
          <% end %>
        </div>
      <% else %>
        <p class="empty-state">Aucun service pour ce·tte client·e.</p>
      <% end %>
      <% if service_error %>
        <p class="field__error" id="session_fliip_service_id_error">Service : <%= service_error %></p>
      <% end %>
    </fieldset>

    <% if @staff.any? %>
      <section class="form-section" aria-labelledby="saisir-qui">
        <header class="form-section__head"><h2 id="saisir-qui">Entraîneur·e</h2></header>
        <div class="form-grid form-grid--single">
          <%= f.select_field :user_id, @staff.map { |u| [ u.full_name, u.id ] }, label: "Donnée par",
                icon: LayoutHelper::NAV_ICONS["clients"],
                include_blank: (@owner_required ? "Choisir un·e employé·e" : "Moi (#{current_user.full_name})"),
                required: @owner_required, data: { action: "change->recent-trainer#reload" } %>
        </div>
      </section>
    <% end %>

    <section class="form-section" aria-labelledby="saisir-quand">
      <header class="form-section__head"><h2 id="saisir-quand">Quand</h2></header>
      <div class="form-grid form-grid--when">
        <%= f.field :date, label: "Date", as: :date, required: true, icon: LayoutHelper::CALENDAR_ICON,
              value: params.dig(:session, :date).presence || @session.occurred_at&.to_date&.iso8601 || Time.zone.today.iso8601,
              data: { confirm_dialog_target: "date" } %>
        <%= f.field :time, label: "Heure", as: :time, required: true, step: 1800, icon: LayoutHelper::CLOCK_ICON,
              value: params.dig(:session, :time).presence || @session.occurred_at&.strftime("%H:%M") || default_time_slot_str %>
        <%= f.segmented :duration, [ [ "1 h", "1.0" ], [ "30 min", "0.5" ] ], label: "Durée", icon: LayoutHelper::DURATION_ICON %>
      </div>
    </section>

    <%= f.field :note, label: "Note", as: :textarea, rows: 2, placeholder: "Facultatif" %>

    <%= render "sessions/confirm_dialog" %>
  <% end %>
<% end %>
