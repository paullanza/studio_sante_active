<%# « Saisir »: log a séance or a consultation. The form in grouped rows on the
    left, a ticket (Récapitulatif and the gold button) on the right from 1024 px,
    under the form on a phone. On the séance tab the trainer's latest séances
    follow the ticket. %>
<% content_for :nav_section, "saisir" %>
<% content_for :title, "Saisir" %>
<% content_for :page_wide, true %>

<div class="page-bar">
  <h1 class="saisir__title">Saisir</h1>
  <%= button_to refresh_clients_path, class: "btn btn--ghost btn--small",
        form: { data: { turbo_confirm: "Ceci va chercher les nouveaux clients dans Fliip. Continuer?" } } do %>
    <%= safe_join([ icon_svg(LayoutHelper::REFRESH_ICON, size: 16), "Rafraîchir les clients" ]) %>
  <% end %>
</div>

<% if @tab == "session" %>
  <% session_ready = @client.present? %>
  <div class="saisir"
       <% if session_ready %>
         data-controller="seance-outcome confirm-dialog recent-trainer form-summary"
         data-recent-trainer-url-value="<%= new_seance_path(fliip_user_id: @client.id) %>"
         data-action="change->seance-outcome#update change->form-summary#update input->form-summary#update"
       <% end %>>
    <div class="saisir__main">
      <%= render "bookings/tabs" %>
      <%= render "bookings/session_form" %>
    </div>

    <div class="saisir__side">
      <%= render "bookings/session_ticket" if session_ready %>

      <%# Reloaded alone (Turbo frame) when an admin changes the trainer. %>
      <%= turbo_frame_tag "recent_sessions", class: "saisir__recent" do %>
        <section class="saisir__recent-list" aria-labelledby="recent-title">
          <div class="list-toolbar">
            <h2 id="recent-title" class="saisir__subtitle"><%= @trainer == current_user ? "Mes 10 dernières séances" : "10 dernières séances" %></h2>
            <% if @trainer != current_user %><span class="text-muted text-small"><%= @trainer.full_name %></span><% end %>
          </div>
          <% if @recent_sessions.any? %>
            <ul class="list">
              <%= render partial: "bookings/recent_session", collection: @recent_sessions, as: :session %>
            </ul>
          <% else %>
            <p class="empty-state">Aucune séance.</p>
          <% end %>
        </section>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="saisir" data-controller="form-summary"
       data-action="change->form-summary#update input->form-summary#update">
    <div class="saisir__main">
      <%= render "bookings/tabs" %>
      <%= render "bookings/consultation_form" %>
    </div>
    <div class="saisir__side">
      <%= render "bookings/consultation_ticket" %>
    </div>
  </div>
<% end %>
