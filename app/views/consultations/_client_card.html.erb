<%# A consultation on the Client page: when, presence, trainer, and the service it's linked to.
    Local: consultation. %>
<li class="card consultation-card">
  <div class="service-card__head">
    <span class="consultation-card__when numeric">
      <%= consultation.occurred_at ? consultation.occurred_at.strftime("%d/%m/%Y · %H h %M") : "—" %>
    </span>
    <% if consultation.present %>
      <span class="badge badge--chargee">Présent·e</span>
    <% elsif consultation.present == false %>
      <span class="badge badge--absence">Absent·e</span>
    <% end %>
  </div>
  <span class="text-muted text-small">
    <%= consultation.user&.full_name.presence || "—" %>
    <% if (service = consultation.fliip_service) %>
      · liée à <%= link_to service.service_name.presence || "Service", fliip_service_path(service) %>
    <% end %>
  </span>
</li>
