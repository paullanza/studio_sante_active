<%# A consultation linked to a service, on the Service page: a card on a phone, a row from
    1024 px laid out like a séance row. An absent prospect gets the Absence stripe.
    Local: consultation. %>
<li class="card seance-card seance-card--session<%= " seance-card--absence" if consultation.present == false %>">
  <div class="seance-card__tag">
    <span class="seance-card__title">Consultation</span>
    <% if consultation.present %>
      <span class="badge badge--chargee">Présent·e</span>
    <% elsif consultation.present == false %>
      <span class="badge badge--absence">Absent·e</span>
    <% end %>
  </div>
  <div class="seance-card__main">
    <div class="seance-card__when numeric">
      <%= consultation.occurred_at ? consultation.occurred_at.strftime("%d/%m/%Y · %H h %M") : "—" %>
    </div>
    <div class="text-muted text-small numeric">créée : <%= consultation.created_at.strftime("%d/%m/%Y %H:%M") %></div>
  </div>
  <div class="seance-card__people text-small">
    <span>Entraîneur·e : <%= consultation.user&.full_name.presence || "—" %></span>
    <% if consultation.created_by_id != consultation.user_id %>
      <span class="text-muted">Saisie par <%= consultation.created_by&.full_name.presence || "—" %></span>
    <% end %>
  </div>
  <div class="seance-card__status text-small"><%= confirmation_status(consultation) %></div>
</li>
