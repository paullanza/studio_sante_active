<%# « Lier les consultations » (managers and above): the consultations still
    without a service, newest first, with the trainer, date and name filters.
    « Lier » on a card opens the link form in place; once linked to a service
    the card leaves the list. %>
<% content_for :nav_section, "plus" %>
<% content_for :title, "Lier les consultations" %>
<% content_for :page_wide, true %>

<div class="stack">
  <div class="page-header">
    <h1>Lier les consultations</h1>
    <p class="text-muted"><span id="to_link_count" class="numeric"><%= @to_link_count %></span> consultation(s) à lier</p>
  </div>

  <%= form_with url: associations_consultations_path, method: :get, class: "link-filters",
        data: { controller: "autosubmit", action: "change->autosubmit#submit" } do %>
    <div class="field field--compact">
      <label class="field__box" for="employee_id">
        <span class="field__label">Entraîneur·e</span>
        <%= select_tag :employee_id, options_for_select(@staff.map { |u| [ u.full_name, u.id ] }, @filter_params[:employee_id]),
              include_blank: "Tous", id: "employee_id", class: "field__input" %>
      </label>
    </div>
    <div class="field field--compact">
      <label class="field__box" for="consultation_date_from">
        <span class="field__label">Du</span>
        <%= date_field_tag :consultation_date_from, @filter_params[:consultation_date_from], id: "consultation_date_from", class: "field__input" %>
      </label>
    </div>
    <div class="field field--compact">
      <label class="field__box" for="consultation_date_to">
        <span class="field__label">Au</span>
        <%= date_field_tag :consultation_date_to, @filter_params[:consultation_date_to], id: "consultation_date_to", class: "field__input" %>
      </label>
    </div>
    <div class="field field--compact">
      <label class="field__box" for="q">
        <span class="field__label">Prospect</span>
        <%= search_field_tag :q, @filter_params[:q], id: "q", class: "field__input", placeholder: "Nom, courriel ou téléphone", autocomplete: "off" %>
      </label>
    </div>
    <noscript><button type="submit" class="btn btn--ghost">Filtrer</button></noscript>
  <% end %>

  <% if @consultations.empty? %>
    <p class="empty-state">
      <%= @filter_params.values.any? ? "Aucune consultation à lier pour ces filtres." : "Toutes les consultations sont liées." %>
    </p>
  <% else %>
    <%= render "shared/pager", pagy: @pagy %>
    <ul class="list card-grid">
      <% @consultations.each do |consultation| %>
        <li id="<%= dom_id(consultation, :item) %>"><%= render "consultations/card", consultation: consultation, context: "lier" %></li>
      <% end %>
    </ul>
    <%= render "shared/pager", pagy: @pagy %>
  <% end %>
</div>
