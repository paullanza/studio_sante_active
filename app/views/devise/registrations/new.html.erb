<% content_for :title, "Créer un compte" %>

<div class="page-full auth">
  <%= back_link_to "Connexion", new_user_session_path %>

  <div class="page-header">
    <h1>Créer un compte</h1>
  </div>

  <%= form_with model: resource, scope: resource_name, url: user_registration_path,
        builder: StudioFormBuilder, class: "form form--grid" do |f| %>
    <%# Two columns from 768 px, filled in this (mobile) order. %>
    <%= f.base_errors %>

    <%= f.field :signup_code_token, label: "Code d'inscription", hint: "8 caractères",
          autocomplete: "off", autocapitalize: "characters", spellcheck: false, required: true, autofocus: true %>
    <div class="from-tablet" aria-hidden="true"></div>

    <%= f.field :first_name, label: "Prénom", autocomplete: "given-name", required: true %>
    <%= f.field :last_name, label: "Nom", autocomplete: "family-name", required: true %>

    <%= f.field :phone, label: "Téléphone", as: :tel, autocomplete: "tel", required: true %>

    <%= f.field :birthday, label: "Date de naissance", as: :date, max: Date.current, required: true %>

    <%# The builder can't render <mapbox-search-box>, so this is the .field markup by hand.
        The controller inserts the search box right after the hidden input. %>
    <% address_error = resource.errors[:address].first %>
    <div class="<%= class_names("field", "field--invalid" => address_error) %>"
         data-controller="address-autocomplete"
         data-address-autocomplete-api-key-value="<%= ENV["MAPBOX_API_KEY"] %>">
      <span class="field__label">Adresse</span>
      <%= f.hidden_field :address, data: { address_autocomplete_target: "address" } %>
      <% if address_error %>
        <p class="field__error"><%= address_error %></p>
      <% end %>
    </div>

    <%= f.field :email, label: "Courriel", as: :email,
          autocomplete: "email", autocapitalize: "none", spellcheck: false, required: true %>

    <%= f.field :password, label: "Mot de passe", as: :password,
          hint: "#{@minimum_password_length || 8} caractères minimum", autocomplete: "new-password", required: true %>

    <%= f.field :password_confirmation, label: "Confirmer le mot de passe", as: :password,
          autocomplete: "new-password", required: true %>

    <%= f.submit "Créer mon compte", block: true %>
  <% end %>

  <p class="text-muted text-small">
    Vous avez déjà un compte?
    <%= link_to "Se connecter", new_user_session_path %>
  </p>
</div>
