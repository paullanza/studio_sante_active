<% content_for :title, "Connexion" %>

<div class="auth-split">
  <aside class="auth-split__panel">
    <p class="eyebrow">Se connecter</p>
    <h1 class="auth-split__title">Bon retour.</h1>
    <p class="auth-split__lead">Connectez-vous avec le courriel de votre compte.</p>
  </aside>

  <%= form_with model: resource, scope: resource_name, url: user_session_path,
        builder: StudioFormBuilder, class: "form auth-split__form" do |f| %>
    <section class="form-section">
      <%= f.field :email, label: "Courriel", as: :email,
            autocomplete: "email", autocapitalize: "none", spellcheck: false, required: true, autofocus: true %>

      <%= f.field :password, label: "Mot de passe", as: :password,
            autocomplete: "current-password", required: true,
            label_aside: link_to("Mot de passe oublié?", password_help_path) %>

      <% if devise_mapping.rememberable? %>
        <%= f.check :remember_me, label: "Se souvenir de moi" %>
      <% end %>
    </section>

    <div class="form-actions">
      <%= f.submit "Se connecter" %>
    </div>
  <% end %>

  <% if devise_mapping.registerable? %>
    <p class="auth-split__foot">
      Nouvelle ou nouveau membre du personnel?
      <%= link_to "Créer un compte", new_user_registration_path %>
    </p>
  <% end %>
</div>
