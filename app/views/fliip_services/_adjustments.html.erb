<%# The Ajustements tab of the Service page: the list, then (admins) the add form.
    Locals: service, adjustments (newest first), adjustment (a new one, or nil), staff. %>
<%= render "service_usage_adjustments/list", service: service, adjustments: adjustments %>
<% if adjustment %>
  <%= render "service_usage_adjustments/new_form", service: service, adjustment: adjustment, staff: staff %>
<% end %>
