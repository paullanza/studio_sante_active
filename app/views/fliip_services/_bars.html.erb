<%# A service's two thin bars, Temps and Séances, each with its label and percentage above.
    Colours follow ProgressHelper. The Séances bar is left out until the allocation is set.
    Local: service. %>
<% time_pct = service.time_progress_percent || 0 %>
<% paid_pct = service.paid_progress_percent || 0 %>
<div class="service-bars">
  <%= service_bar("Temps", time_pct, progress_base_color(time_pct)) %>
  <% unless service.allocation_to_define? %>
    <%= service_bar("Séances", paid_pct, progress_usage_color(paid_pct, time_pct)) %>
  <% end %>
</div>
