<%# A service as a card on a phone and a row from 1024 px (Client page, Mes services, Échéances).
    The whole card opens the Service page.
    Locals: service, show_client (default false: when true, the client's name is the card's title
    and the service name sits under it, for lists people scan by client),
    trainers (default none: staff names, shown as « Entraîneur·e·s : … » when given). %>
<% removed = service.removed_from_fliip? %>
<li>
  <%= link_to fliip_service_path(service), class: "card service-card" do %>
    <% service_name = service.service_name.presence || "Service" %>
    <% client_title = local_assigns[:show_client] && service.fliip_user %>
    <div class="service-card__head">
      <span class="service-card__name"><%= client_title ? service.fliip_user.full_name : service_name %></span>
      <%= service_status_badge(service) %>
    </div>
    <% if client_title %>
      <span class="service-card__service text-small"><%= service_name %></span>
    <% end %>

    <div class="service-card__dates numeric">
      <% if removed %>
        historique seulement
      <% else %>
        <%= [ service.start_date ? l(service.start_date) : "?", service.expire_date ? l(service.expire_date) : "?" ].join(" → ") %>
        <% if (overrun = service.overrun_label) %><span class="service-card__overrun"><span class="service-card__sep"> · </span><%= overrun %></span><% end %>
      <% end %>
    </div>

    <% unless removed %>
      <div class="service-card__usage">
        <%= render "fliip_services/bars", service: service %>
        <div class="text-muted text-small numeric">
          <% if service.allocation_to_define? %>
            Allocation à définir
          <% else %>
            <%= format_count(service.paid_used_total) %> / <%= format_count(service.paid_allowed_total) %> séances ·
            <%= format_count(service.free_used_total) %> / <%= format_count(service.free_allowed_total) %> absences
          <% end %>
        </div>
      </div>
    <% end %>

    <% if local_assigns.key?(:trainers) %>
      <div class="service-card__trainers text-small">Entraîneur·e·s : <%= trainers.presence&.join(", ") || "—" %></div>
    <% end %>

    <div class="service-card__ids text-muted text-small numeric">
      Serv# <%= service.id %> · Achat# <%= service.remote_purchase_id %> · DefID <%= service.service_id || "—" %>
    </div>
  <% end %>
</li>
