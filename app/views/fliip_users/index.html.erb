<% content_for :nav_section, "clients" %>
<% content_for :title, "Clients" %>
<% content_for :page_wide, true %>

<div class="stack">
  <div class="page-header">
    <h1>Clients</h1>
  </div>

  <%= form_with url: fliip_users_path, method: :get, class: "search-form", role: "search" do %>
    <div class="field field--compact search-form__field">
      <label class="field__box" for="query">
        <span class="field__label visually-hidden">Nom, courriel ou téléphone</span>
        <%= search_field_tag :query, @query, id: "query", class: "field__input",
              placeholder: "Nom, courriel ou téléphone",
              autofocus: true, autocomplete: "off", inputmode: "search", spellcheck: false %>
      </label>
    </div>
    <button type="submit" class="btn btn--primary">Rechercher</button>
  <% end %>

  <% if @fliip_users.empty? %>
    <p class="text-muted">
      <%= @query.present? ? "Aucun client ne correspond à « #{@query} »." : "Aucun client." %>
    </p>
  <% else %>
    <div class="list-toolbar">
      <p class="text-muted text-small numeric">
        <%= pluralize(@pagy.count, "client") %><% if @query.present? %> pour « <%= @query %> » · <%= link_to "Tous les clients", fliip_users_path %><% end %>
      </p>
      <%= render "shared/pager", pagy: @pagy %>
    </div>

    <div class="client-list">
      <div class="client-list__head" aria-hidden="true">
        <span>Client</span><span>Contact</span><span>Service</span><span>Progression</span>
      </div>
      <ul class="list">
        <%= render partial: "fliip_users/client_card", collection: @fliip_users, as: :client,
              locals: { recent: @recent_services_by_user_id } %>
      </ul>
    </div>

    <%= render "shared/pager", pagy: @pagy %>
  <% end %>
</div>
