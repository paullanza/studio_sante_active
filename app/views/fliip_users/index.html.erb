<% content_for :nav_section, "clients" %>
<% content_for :title, "Clients" %>

<div class="stack">
  <div class="page-header">
    <h1>Clients</h1>
  </div>

  <%= form_with url: fliip_users_path, method: :get, class: "search-form", role: "search" do %>
    <div class="field search-form__field">
      <label class="field__box" for="query">
        <span class="field__label">Nom, courriel ou téléphone</span>
        <%= search_field_tag :query, @query, id: "query", class: "field__input",
              autofocus: true, autocomplete: "off", inputmode: "search", spellcheck: false %>
      </label>
    </div>
    <button type="submit" class="btn btn--primary">Rechercher</button>
  <% end %>

  <% if @query.blank? %>
    <p class="text-muted">Cherchez un client par nom, courriel ou téléphone.</p>
  <% elsif @fliip_users.empty? %>
    <p class="text-muted">Aucun client ne correspond à « <%= @query %> ».</p>
  <% else %>
    <p class="text-muted text-small numeric"><%= pluralize(@pagy.count, "client") %></p>

    <ul class="list until-tablet">
      <%= render partial: "fliip_users/search_result", collection: @fliip_users, as: :client,
            locals: { recent: @recent_services_by_user_id } %>
    </ul>

    <table class="table from-tablet client-table">
      <thead>
        <tr><th>Client</th><th>Téléphone</th><th>Courriel</th><th>Service</th></tr>
      </thead>
      <tbody>
        <% @fliip_users.each do |client| %>
          <% item = @recent_services_by_user_id[client.id] %>
          <tr class="row-link">
            <td>
              <%= link_to client.full_name, fliip_user_path(client), class: "client-name row-link__target" %>
              <div class="text-muted text-small numeric">ID <%= client.id %> · FliipUserID <%= client.remote_id %></div>
            </td>
            <td class="numeric"><%= [ client.user_phone1, client.user_phone2 ].compact_blank.first || "—" %></td>
            <td class="client-table__email"><%= client.user_email.presence || "—" %></td>
            <td><%= render "fliip_users/main_service", item: item %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @pagy.pages > 1 %>
      <nav class="pager" aria-label="Pages">
        <% if @pagy.previous %>
          <%= link_to "Précédent", fliip_users_path(query: @query, page: @pagy.previous), class: "btn btn--ghost", rel: "prev" %>
        <% else %>
          <span></span>
        <% end %>
        <span class="text-muted text-small numeric">Page <%= @pagy.page %> sur <%= @pagy.pages %></span>
        <% if @pagy.next %>
          <%= link_to fliip_users_path(query: @query, page: @pagy.next), class: "btn btn--secondary", rel: "next" do %>
            <%= safe_join([ "Suivant", button_arrow ]) %>
          <% end %>
        <% else %>
          <span></span>
        <% end %>
      </nav>
    <% end %>
  <% end %>
</div>
