<% content_for :nav_section, "clients" %>
<% content_for :title, @fliip_user.full_name %>
<% content_for :page_wide, true %>

<div class="page-bar">
  <%= back_link_to "Clients", fliip_users_path %>
  <%= button_to refresh_fliip_user_path(@fliip_user.remote_id), class: "btn btn--secondary btn--small" do %>
    <%= icon_svg(LayoutHelper::REFRESH_ICON, size: 16) %>
    Rafraîchir
  <% end %>
</div>

<div class="client-page">
  <section class="card card--top client-page__top" aria-labelledby="client-name">
    <div class="client-top__who">
      <%= client_avatar(@fliip_user) %>
      <div class="client-top__name">
        <h1 id="client-name"><%= @fliip_user.full_name.presence || "—" %></h1>
        <span class="text-muted text-small numeric">ID <%= @fliip_user.id %> · FliipUserID <%= @fliip_user.remote_id %></span>
      </div>
    </div>

    <% if @fliip_user.missing_from_fliip? %>
      <div><span class="badge badge--retire">Retiré de Fliip</span></div>
    <% end %>

    <% phones = [ @fliip_user.user_phone1, @fliip_user.user_phone2 ].compact_blank.uniq %>
    <% if phones.any? || @fliip_user.user_email.present? %>
      <div class="contact-links">
        <% phones.each do |phone| %>
          <% if (href = phone_href(phone)) %>
            <%= link_to href, class: "contact-link numeric" do %>
              <%= icon_svg(LayoutHelper::PHONE_ICON, size: 18) %><span class="contact-link__text"><%= format_phone(phone) %></span>
            <% end %>
          <% else %>
            <span class="contact-link numeric"><%= icon_svg(LayoutHelper::PHONE_ICON, size: 18) %><span class="contact-link__text"><%= phone %></span></span>
          <% end %>
        <% end %>
        <% if @fliip_user.user_email.present? %>
          <%= mail_to @fliip_user.user_email, class: "contact-link" do %>
            <%= icon_svg(LayoutHelper::MAIL_ICON, size: 18) %><span class="contact-link__text"><%= @fliip_user.user_email %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="stats">
      <% active = @fliip_user.active_services_count %>
      <div class="stat">
        <span class="stat__value"><%= active %></span>
        <span class="stat__label"><%= active == 1 ? "service actif" : "services actifs" %></span>
      </div>
      <div class="stat">
        <span class="stat__value"><%= format_count(@fliip_user.remaining_sessions_total) %></span>
        <span class="stat__label">séances restantes</span>
      </div>
      <div class="stat">
        <% last = @fliip_user.last_session_at %>
        <span class="stat__value numeric"><%= last ? last.strftime("%d/%m") : "—" %></span>
        <span class="stat__label">dernière séance</span>
      </div>
    </div>

    <% address = [ @fliip_user.user_address, @fliip_user.user_city, @fliip_user.user_zipcode ].compact_blank.join(", ") %>
    <dl class="facts facts--3">
      <div><dt>Membre depuis</dt><dd class="numeric"><%= @fliip_user.member_since ? l(@fliip_user.member_since) : "—" %></dd></div>
      <div><dt>Statut Fliip</dt><dd><%= @fliip_user.user_status.presence || "—" %></dd></div>
      <div><dt>Genre</dt><dd><%= @fliip_user.user_gender.presence || "—" %></dd></div>
      <div class="facts__wide"><dt>Adresse</dt><dd><%= address.presence || "—" %></dd></div>
    </dl>

    <p class="text-muted text-small">
      <% if @fliip_user.synced_at %>
        <time datetime="<%= @fliip_user.synced_at.iso8601 %>" title="<%= l(@fliip_user.synced_at) %>">Synchronisé avec Fliip il y a <%= time_ago_in_words(@fliip_user.synced_at) %></time>
      <% else %>
        Jamais synchronisé depuis l'app
      <% end %>
    </p>
  </section>

  <div class="client-page__tabs">
    <nav class="tabs" aria-label="Sections">
      <% [ [ "services", "Services", @services.size ], [ "contracts", "Abonnements", @contracts.size ],
           [ "consultations", "Consultations", @consultations.size ] ].each do |key, label, count| %>
        <%# The consultation count is refreshed alone after a delete. %>
        <%= link_to safe_join([ "#{label} (", tag.span(count, id: (dom_id(@fliip_user, :consultations_count) if key == "consultations")), ")" ]),
              fliip_user_path(@fliip_user, tab: key), class: "tabs__tab",
              aria: { current: (@tab == key ? "page" : nil) } %>
      <% end %>
    </nav>

    <% case @tab %>
    <% when "services" %>
      <% if @services.any? %>
        <ul class="list card-grid">
          <%= render partial: "fliip_services/card", collection: @services, as: :service, locals: { show_client: false } %>
        </ul>
      <% else %>
        <p class="empty-state">Aucun service.</p>
      <% end %>
    <% when "contracts" %>
      <% if @contracts.any? %>
        <ul class="list card-grid">
          <%= render partial: "fliip_contracts/card", collection: @contracts, as: :contract %>
        </ul>
      <% else %>
        <p class="empty-state">Aucun abonnement.</p>
      <% end %>
    <% when "consultations" %>
      <% if @consultations.any? %>
        <ul class="list card-grid">
          <% @consultations.each do |consultation| %>
            <li id="<%= dom_id(consultation, :item) %>"><%= render "consultations/card", consultation: consultation, context: "client" %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Aucune consultation.</p>
      <% end %>
    <% end %>
  </div>
</div>
