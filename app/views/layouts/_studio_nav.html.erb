<%# Top nav on every screen size. Each « Plus » item asks its policy; no role checks here. %>
<nav class="top-nav" aria-label="Navigation principale">
  <div class="top-nav__inner">
    <%= nav_tab_to "Dashboard", dashboard_path_for(current_user), :dashboard %>
    <%= nav_tab_to "Clients", fliip_users_path, :clients %>
    <%= nav_tab_to "Saisir", new_seance_path, :saisir %>
    <%= nav_tab_to "Mes services", my_services_path, :mes_services %>

    <details class="nav-more">
      <summary class="<%= class_names("nav-tab", "is-active" => nav_section_active?(:plus)) %>">
        <%= nav_icon(:plus) %>
        <span class="nav-tab__label">Plus</span>
      </summary>

      <div class="nav-more__menu">
        <%= link_to "Mon profil", profile_path, class: "nav-more__item" %>
        <% if policy(:admin).session_confirmations? %>
          <%= link_to "Confirmations", session_confirmations_path, class: "nav-more__item" %>
        <% end %>
        <% if policy(Consultation).associations? %>
          <%= link_to "Lier les consultations", associations_consultations_path, class: "nav-more__item" %>
        <% end %>
        <% if policy(:oversight).echeances? %>
          <%= link_to "Échéances", echeances_path, class: "nav-more__item" %>
        <% end %>
        <% if policy(:oversight).recent_sessions? %>
          <%= link_to "Séances récentes", recent_sessions_path, class: "nav-more__item" %>
        <% end %>
        <% if policy(ServiceDefinition).index? %>
          <%= link_to "Allocations", allocations_path, class: "nav-more__item" %>
        <% end %>
        <% if policy(:admin).jobs? %>
          <%= link_to "Tâches", mission_control_jobs_path, class: "nav-more__item", data: { turbo: false } %>
        <% end %>
        <%= button_to "Se déconnecter", destroy_user_session_path, method: :delete,
              class: "nav-more__item nav-more__item--signout", form_class: "nav-more__form" %>
      </div>
    </details>
  </div>
</nav>
