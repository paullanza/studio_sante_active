<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · GEKO" : "GEKO · Studio Santé Active" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="color-scheme" content="dark">
    <%# Full-screen web app: installable from the browser's « Ajouter à l'écran d'accueil ».
        Meta tags can't read CSS variables, so the theme colour is --surface written out. %>
    <meta name="theme-color" content="#16201A">
    <meta name="application-name" content="GEKO">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="GEKO">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "studio", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "studio" %>
  </head>

  <body class="studio">
    <%# Brand bar above the tabs on a phone; beside them from 1024 px. %>
    <div class="masthead">
      <header class="brand-bar">
        <div class="brand-bar__inner">
          <%= link_to home_path, class: "brand", aria: { label: "GEKO par Studio Santé Active, accueil" } do %>
            <span class="brand__name">GEKO</span>
            <span class="brand__by">par Studio Santé Active</span>
          <% end %>
          <% if user_signed_in? %>
            <%# Who is signed in: right of the brand on a phone, right of the tabs from 1024 px. %>
            <p class="signed-in-as">
              <span class="visually-hidden">Connecté·e :</span>
              <span class="signed-in-as__name"><%= current_user.full_name.strip.presence || current_user.email %></span>
            </p>
          <% end %>
        </div>
      </header>

      <%= render "layouts/studio_nav" if user_signed_in? %>
    </div>

    <div class="flash-region" id="flash">
      <%= render "shared/studio_flash" %>
    </div>

    <main class="<%= class_names("page", "page--wide" => content_for?(:page_wide)) %>" id="contenu">
      <%= yield %>
    </main>
  </body>
</html>
