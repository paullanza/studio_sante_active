<%# A séance in Séances récentes: a card on a phone, a row under .recent-seances__head from
    768 px. The whole row opens the séance's service. An Absence or a -24h séance gets the
    same stripe and tint as on the Service page. Locals: session. %>
<li>
  <%= link_to fliip_service_path(session.fliip_service_id), class: "card recent-seance recent-seance--#{session.outcome}" do %>
    <span class="recent-seance__when numeric"><%= seance_datetime(session.occurred_at) %></span>
    <span class="recent-seance__who">
      <span class="recent-seance__client"><%= session.fliip_user&.full_name.presence || "—" %></span>
      <span class="recent-seance__service text-small text-muted"><%= session.fliip_service&.service_name.presence || "Service" %></span>
    </span>
    <span class="recent-seance__trainer text-small">
      <span class="recent-seance__trainer-label">Entraîneur·e : </span><%= session.user&.full_name.presence || "—" %>
    </span>
    <span class="recent-seance__outcome">
      <span class="badge <%= outcome_badge_class(session) %>"><%= session.outcome_label %></span>
      <span class="numeric text-small"><%= session.duration_short %></span>
    </span>
    <span class="recent-seance__status text-small"><%= confirmation_status(session) %></span>
  <% end %>
</li>
