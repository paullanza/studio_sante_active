<%# « Modifier » and « Supprimer » on a séance, inside its Turbo frame. `context`
    ("saisir") and `trainer_id` tell the controller which list to draw again.
    `stacked: true` puts them one above the other (the Service page card).
    Locals: session, context (optional), trainer_id (optional), stacked (optional). %>
<% context = local_assigns[:context] %>
<% trainer_id = local_assigns[:trainer_id] %>
<% can_edit = policy(session).update? %>
<% can_delete = policy(session).destroy? %>
<% if can_edit || can_delete %>
  <div class="seance-card__actions<%= " seance-card__actions--stacked" if local_assigns[:stacked] %>">
    <% if can_edit %>
      <%= link_to "Modifier", edit_session_path(session, context: context, trainer_id: trainer_id),
            class: "btn btn--secondary btn--small" %>
    <% end %>
    <% if can_delete %>
      <%= button_to "Supprimer", session_path(session), method: :delete,
            params: { context: context, trainer_id: trainer_id }.compact,
            class: "btn btn--danger btn--small",
            form: { data: { turbo_confirm: "Supprimer cette séance? Cette action est irréversible." } } %>
    <% end %>
  </div>
<% end %>
