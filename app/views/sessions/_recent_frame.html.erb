<%# A row of Saisir's latest séances in its Turbo frame, where « Modifier » swaps
    in sessions/_edit_card. Locals: session, trainer_id (the list's trainer). %>
<%= turbo_frame_tag dom_id(session), class: "seance-frame" do %>
  <%= render "bookings/recent_session", session: session, trainer_id: trainer_id %>
<% end %>
