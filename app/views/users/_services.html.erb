<%# The Services tab: the services this staff member works on, as on Mes
    services, with the same toggles. Locals: user, services. %>
<div class="stack">
  <div class="list-toolbar">
    <p class="text-muted text-small numeric"><%= pluralize(services.size, "service") %></p>
    <%= form_with url: user_path(user), method: :get, class: "filter-toggles",
          data: { controller: "autosubmit", action: "change->autosubmit#submit", turbo_action: "replace" } do %>
      <%= hidden_field_tag :tab, "services", id: nil %>
      <label class="checkbox">
        <%= check_box_tag :inactifs, "1", @show_inactive, class: "checkbox__input" %>
        <span class="checkbox__label">Inactifs</span>
      </label>
      <label class="checkbox">
        <%= check_box_tag :annules, "1", @show_cancelled, class: "checkbox__input" %>
        <span class="checkbox__label">Annulés</span>
      </label>
      <noscript><button type="submit" class="btn btn--secondary btn--small">Filtrer</button></noscript>
    <% end %>
  </div>

  <% if services.any? %>
    <ul class="list card-grid">
      <%= render partial: "fliip_services/card", collection: services, as: :service, locals: { show_client: true } %>
    </ul>
  <% else %>
    <p class="empty-state">Aucun service pour l'instant.</p>
  <% end %>
</div>
