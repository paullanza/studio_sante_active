<%# A staff member's top card: name, role, status, contact, birthday and
    address, then the account actions the viewer may take (UserPolicy).
    Local: user. %>
<% user_policy = policy(user) %>
<section class="card card--top client-page__top" aria-labelledby="staff-name">
  <div class="client-top__name">
    <h1 id="staff-name"><%= user.full_name.presence || "—" %></h1>
    <span class="text-muted"><%= user.translated_role %> · <%= user.active? ? "Actif·ve" : "Inactif·ve" %></span>
  </div>

  <% if user.phone.present? || user.email.present? %>
    <div class="contact-links">
      <% if user.phone.present? %>
        <% if (href = phone_href(user.phone)) %>
          <%= link_to href, class: "contact-link numeric" do %>
            <%= icon_svg(LayoutHelper::PHONE_ICON, size: 18) %><span class="contact-link__text"><%= format_phone(user.phone) %></span>
          <% end %>
        <% else %>
          <span class="contact-link numeric"><%= icon_svg(LayoutHelper::PHONE_ICON, size: 18) %><span class="contact-link__text"><%= user.phone %></span></span>
        <% end %>
      <% end %>
      <% if user.email.present? %>
        <%= mail_to user.email, class: "contact-link" do %>
          <%= icon_svg(LayoutHelper::MAIL_ICON, size: 18) %><span class="contact-link__text"><%= user.email %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <dl class="facts">
    <div><dt>Date de naissance</dt><dd class="numeric"><%= user.birthday ? l(user.birthday) : "—" %></dd></div>
    <div class="facts__wide"><dt>Adresse</dt><dd><%= user.address.presence || "—" %></dd></div>
  </dl>

  <%# Account actions, until their own pages replace them (ENG-209, ENG-210). %>
  <% actions = capture do %>
    <% if user == current_user %>
      <%= link_to "Modifier mon profil", profile_path, class: "btn btn--secondary btn--small" %>
    <% elsif user_policy.update? %>
      <%= link_to "Modifier le profil", edit_user_path(user), class: "btn btn--secondary btn--small" %>
    <% end %>
    <% if (user.admin? || user.employee?) && user_policy.make_manager? %>
      <%= button_to "Nommer gestionnaire", make_manager_user_path(user), method: :patch, class: "btn btn--secondary btn--small" %>
    <% end %>
    <% if user.manager? && user_policy.make_employee? %>
      <%= button_to "Nommer employé·e", make_employee_user_path(user), method: :patch, class: "btn btn--secondary btn--small" %>
    <% end %>
    <% if user.manager? && user_policy.make_admin? %>
      <%= button_to "Nommer admin", make_admin_user_path(user), method: :patch, class: "btn btn--secondary btn--small" %>
    <% end %>
    <% if user.active? && user_policy.deactivate? %>
      <%= button_to "Désactiver", deactivate_user_path(user), method: :patch, class: "btn btn--danger btn--small",
            form: { data: { turbo_confirm: "Désactiver #{user.full_name}? Le compte ne pourra plus se connecter." } } %>
    <% elsif !user.active? && user_policy.activate? %>
      <%= button_to "Réactiver", activate_user_path(user), method: :patch, class: "btn btn--secondary btn--small" %>
    <% end %>
  <% end %>
  <% if actions.present? %>
    <div class="staff-actions"><%= actions %></div>
  <% end %>
</section>
