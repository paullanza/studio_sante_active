<%# « À suivre »: four flags (renewals coming up, no séance for a while, a
    falling trend, unconfirmed work), each listing who it concerns, then the
    team in one compact row each. Local: overview (StaffOverview). %>
<% alerts = overview.alerts %>
<% kinds = [
     [ :renewals, "renouvellement(s) à venir", "warning", ->(r) { "#{r.renewals} service(s)" }, alerts[:renewals].sum(&:renewals) ],
     [ :inactive, "sans séance depuis #{StaffOverview::INACTIVE_AFTER_DAYS} j", "danger", ->(r) { last_session_label(r) }, alerts[:inactive].size ],
     [ :falling, "en baisse sur #{StaffOverview::TREND_WEEKS} semaines", "danger", ->(r) { r.falling_label }, alerts[:falling].size ],
     [ :unconfirmed, "non confirmée(s)", "unconfirmed", ->(r) { r.unconfirmed.to_s }, alerts[:unconfirmed].sum(&:unconfirmed) ]
   ] %>
<section class="follow-up" aria-labelledby="a-suivre">
  <h2 id="a-suivre" class="section-label">À suivre</h2>
  <div class="follow-up__grid">
    <% kinds.each do |key, title, tone, detail, count| %>
      <div class="follow-up__card follow-up__card--<%= tone %><%= " is-empty" if alerts[key].empty? %>">
        <p class="follow-up__head"><span class="follow-up__count numeric"><%= count %></span> <%= title %></p>
        <% if alerts[key].any? %>
          <ul class="follow-up__people">
            <% alerts[key].each do |row| %>
              <li><%= link_to row.user.full_name, user_path(row.user) %><span class="text-muted numeric"><%= detail.call(row) %></span></li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-muted text-small">Personne.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<section aria-labelledby="equipe">
  <h2 id="equipe" class="section-label">L'équipe cette période</h2>
  <ul class="list team-rows">
    <% overview.rows.sort_by { |r| -r.sessions }.each do |row| %>
      <li>
        <%= link_to user_path(row.user), class: "card team-row" do %>
          <span class="team-row__who"><strong><%= row.user.full_name %></strong><span class="text-muted text-small"><%= row.user.translated_role %></span></span>
          <span class="team-row__count numeric"><strong><%= row.sessions %></strong> <span class="text-muted text-small">séances</span></span>
          <span class="team-row__bar"><%= outcome_bar(row) %></span>
          <span class="text-small numeric"><%= format_count(row.hours) %> h <span class="text-muted">de séance</span></span>
          <span class="text-small numeric"><%= row.consultations %> <span class="text-muted">consult. · <%= sales_label(row) %></span></span>
          <span class="text-small numeric"><%= row.clients %> <span class="text-muted">clients</span></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
