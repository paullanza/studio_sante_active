<%# « Personnel » (managers and above): the staff the viewer may see
    (UserPolicy::Scope) and how each is doing in a pay period, in two views of
    the same figures (StaffOverview): « Tableau » (the renewals to follow up,
    then one row each, with the 8-week trend) and « Fiches » (a card each).
    The filters keep the view. %>
<% content_for :nav_section, "plus" %>
<% content_for :title, "Personnel" %>
<% content_for :page_wide, true %>
<% role_choices = %w[employee manager admin].map { |role| [ User::ROLE_LABELS_FR[role], role ] } %>
<% filters = { periode: @period.to_param, statut: @status, role: @role }.compact %>
<% totals = @overview.totals %>

<div class="stack personnel">
  <div class="page-header">
    <h1>Personnel</h1>
    <p class="text-muted text-small numeric">
      <%= pluralize(@overview.rows.size, "membre") %> · cette période : <%= totals[:sessions] %> séance(s), <%= format_count(totals[:hours]) %> h, <%= totals[:consultations] %> consultation(s)
    </p>
    <% if policy(SignupCode).index? %>
      <p class="text-small"><%= link_to "Codes d'inscription", signup_codes_path %></p>
    <% end %>
  </div>

  <div class="personnel__bar">
    <nav class="tabs" aria-label="Vues">
      <% [ [ "tableau", "Tableau" ], [ "fiches", "Fiches" ] ].each do |key, label| %>
        <%= link_to label, users_path(filters.merge(vue: key)), class: "tabs__tab", aria: { current: (@view == key ? "page" : nil) } %>
      <% end %>
    </nav>

    <%= form_with url: users_path, method: :get, class: "personnel-filters",
          data: { controller: "autosubmit", action: "change->autosubmit#submit", turbo_action: "replace" } do %>
      <%= hidden_field_tag :vue, @view, id: nil %>
      <div class="field field--compact">
        <label class="field__box" for="periode">
          <span class="field__label">Période</span>
          <%= select_tag :periode, options_for_select(@periods.map { |p| [ p.label, p.to_param ] }, @period.to_param),
                id: "periode", class: "field__input" %>
        </label>
      </div>
      <div class="field field--compact">
        <label class="field__box" for="statut">
          <span class="field__label">Statut</span>
          <%= select_tag :statut, options_for_select([ [ "Actifs", "actifs" ], [ "Inactifs", "inactifs" ], [ "Tous", "tous" ] ], @status),
                id: "statut", class: "field__input" %>
        </label>
      </div>
      <div class="field field--compact">
        <label class="field__box" for="role">
          <span class="field__label">Rôle</span>
          <%= select_tag :role, options_for_select(role_choices, @role), include_blank: "Tous", id: "role", class: "field__input" %>
        </label>
      </div>
      <noscript><button type="submit" class="btn btn--ghost">Filtrer</button></noscript>
    <% end %>
  </div>

  <% if @overview.rows.empty? %>
    <p class="empty-state">Personne ne correspond à ces filtres.</p>
  <% else %>
    <%= render "users/view_#{@view}", overview: @overview %>
  <% end %>
</div>
