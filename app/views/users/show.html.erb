<%# A staff member's page (« Personnel »): the top card, then the Activité tab
    (one pay period's séances and consultations, with totals) and the
    Services tab (the services they work on, as on Mes services). Every role
    reaches their own page. %>
<% content_for :nav_section, "plus" %>
<% content_for :title, @user.full_name.presence || @user.email %>
<% content_for :page_wide, true %>

<% if policy(User).index? %>
  <%= back_link_to "Personnel", users_path %>
<% end %>

<div class="client-page">
  <%# The top card and « Accès » share the left column on desktop. %>
  <div class="staff-side">
    <%= render "users/top", user: @user %>
    <%= render "users/access", user: @user %>
  </div>

  <div class="client-page__tabs">
    <nav class="tabs" aria-label="Sections">
      <% [ [ "activite", "Activité" ], [ "services", "Services" ] ].each do |key, label| %>
        <%= link_to label, user_path(@user, tab: key), class: "tabs__tab", aria: { current: (@tab == key ? "page" : nil) } %>
      <% end %>
    </nav>

    <% if @tab == "activite" %>
      <%= render "users/activity", user: @user, activity: @activity %>
    <% else %>
      <%= render "users/services", user: @user, services: @services %>
    <% end %>
  </div>
</div>
